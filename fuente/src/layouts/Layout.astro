---
import '@fontsource/instrument-sans/latin-400.css';
import '@fontsource/instrument-sans/latin-500.css';
import '@fontsource/instrument-sans/latin-600.css';
import '@fontsource/instrument-sans/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '../styles/global.css';

const { titulo, descripcion = 'Tu avance en Ingeniería en Sistemas (Plan 2023, UTN FRC): malla de correlativas, simulador, planificador y electivas.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const ico = {
  inicio: '<path d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  malla: '<circle cx="5" cy="6" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="12" r="2.2"/><path d="M7 7l10 4M7 17l10-4"/>',
  simulador: '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>',
  planificador: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  electivas: '<path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6L3.3 9.3l6.1-.7z"/>',
};
const nav = [
  ['inicio', 'Inicio', base],
  ['malla', 'Malla', `${base}malla/`],
  ['simulador', 'Simulador', `${base}simulador/`],
  ['planificador', 'Planificador', `${base}planificador/`],
  ['electivas', 'Electivas', `${base}electivas/`],
];
const actual = Astro.url.pathname;
const esActual = (href) => (href === base ? actual === base || actual === `${base}index.html` : actual.startsWith(href));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Correlativas</title>
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f0f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a120e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Tema guardado antes del primer pintado (evita el flash). localStorage puede estar bloqueado.
      try { var t = localStorage.getItem('corr:v1:tema'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="sitio">
      <div class="sitio-in">
        <a class="marca" href={base}><img src={`${base}favicon.svg`} alt="" width="32" height="32" />Correlativas</a>
        <nav aria-label="Principal">
          <ul>
            {nav.map(([id, texto, href]) => (
              <li><a href={href} aria-current={esActual(href) ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico[id]} />
                <span>{texto}</span>
              </a></li>
            ))}
          </ul>
        </nav>
        <button type="button" class="tema" data-accion="tema" aria-label="Tema oscuro" aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g data-ico="sol"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g>
            <path data-ico="luna" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
          </svg>
        </button>
        <button type="button" class="sesion" data-accion="sesion" aria-haspopup="dialog" aria-label="Entrar o crear cuenta" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
          <span data-texto>Entrar</span>
        </button>
      </div>
    </header>
    <dialog class="dlg-sesion" data-sesion-dialogo aria-labelledby="dlg-titulo">
      <h2 id="dlg-titulo" data-titulo>Entrar</h2>
      <div data-vista="form">
        <p class="suave">Con tu cuenta el progreso se guarda en la nube y lo ves en cualquier dispositivo.</p>
        <form>
          <label>Mail<input type="email" name="email" autocomplete="email" required /></label>
          <label>Contraseña<input type="password" name="password" minlength="6" autocomplete="current-password" required /></label>
          <button type="submit" class="btn-primario" data-enviar>Entrar</button>
          <button type="button" data-alternar>Crear una cuenta</button>
        </form>
      </div>
      <div data-vista="cuenta" hidden>
        <p>Sesión iniciada como <strong data-mail></strong>.</p>
        <button type="button" data-salir>Salir</button>
      </div>
      <p role="status" class="dlg-aviso"></p>
      <button type="button" class="dlg-x" data-cerrar aria-label="Cerrar">×</button>
    </dialog>
    <main id="contenido"><slot /></main>
    <footer class="pie">
      <div class="pie-in">
        <p><strong>Correlativas · UTN FRC</strong><br />Sitio no oficial para seguir el avance en Ingeniería en Sistemas, Plan 2023.</p>
        <p><strong>Fuente</strong><br />Régimen de correlatividades oficial. Verificá siempre con Alumnos.</p>
        <p><strong>Hecho con Claude</strong><br />Diseño, código y tests hechos con Claude (Anthropic).</p>
      </div>
    </footer>
    <script>
      import '../scripts/ui.js';
      import '../scripts/reveal.js';
      import '../scripts/auth.js';
    </script>
    <script>
      // Tema: claro / oscuro. Sin elección guardada se sigue al sistema.
      const raiz = document.documentElement;
      const btn = document.querySelector('[data-accion="tema"]');
      const efectivo = () => raiz.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const pintar = () => { if (btn) { const osc = efectivo() === 'dark'; btn.dataset.modo = osc ? 'oscuro' : 'claro'; btn.setAttribute('aria-pressed', String(osc)); } };
      if (btn) {
        btn.hidden = false;
        pintar();
        btn.addEventListener('click', () => {
          const nuevo = efectivo() === 'dark' ? 'light' : 'dark';
          raiz.dataset.theme = nuevo;
          try { localStorage.setItem('corr:v1:tema', nuevo); } catch { /* bloqueado: queda solo en esta visita */ }
          pintar();
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', pintar);
      }
    </script>
  </body>
</html>

<style is:global>
  /* Gate de login: con JS, el contenido está oculto hasta que auth.js confirma la sesión (data-sesion="si"). Sin JS se ve todo. */
  .js body:not([data-sesion="si"]) main { display: none; }
  .sesion { flex: none; max-width: 11rem; }
  .sesion svg { width: 20px; height: 20px; flex: none; }
  .sesion span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 900px) { .sesion { width: 44px; padding: 0; border-radius: 50%; } .sesion span { display: none; } }
  .dlg-sesion { position: fixed; inset: 0; margin: auto; width: min(24rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow-y: auto; background: var(--sup); color: var(--texto); border: 1px solid var(--borde); border-radius: var(--r); padding: var(--s-6); box-shadow: var(--sombra-h); }
  .dlg-sesion::backdrop { background: rgb(0 0 0 / .5); }
  .dlg-sesion form { display: grid; gap: var(--s-3); }
  .dlg-sesion label { display: grid; gap: var(--s-1); font-weight: 600; font-size: var(--t-s); }
  .dlg-sesion input { font: inherit; min-height: 44px; padding: 0 var(--s-3); border: 1px solid var(--borde-fuerte); border-radius: var(--r-s); background: var(--sup2); color: var(--texto); min-width: 0; }
  .dlg-aviso { color: var(--error); font-size: var(--t-s); margin: var(--s-3) 0 0; min-height: 1.4em; }
  .dlg-x { position: absolute; top: var(--s-2); right: var(--s-2); width: 44px; padding: 0; border-radius: 50%; font-size: 1.5rem; border-color: transparent; background: transparent; }
</style>
