---
import Layout from '../layouts/Layout.astro';
import { MATERIAS, MATERIAS_PLAN, NIVELES, ESTADO_INICIAL, EXAMENES, CREDITOS_INGENIERIA, CREDITOS_ANALISTA } from '../data/plan.js';
import { resumen, sinCursar, resumenPorNivel, proximosFinales, planProximoAnio, esElectiva } from '../lib/motor.js';
import { NOMBRE_NIVEL, estadoDe, puedeCursar, puedeRendir, destraba, nombreCorto } from '../lib/vista.js';

const base = import.meta.env.BASE_URL;
const r = resumen(ESTADO_INICIAL);
const total = r.total; // 36: el Seminario (opcional) no cuenta
const aprobadas = MATERIAS_PLAN.filter((m) => estadoDe(m.n) === 'aprobada');
const pct = r.pct;
const notas = aprobadas.map((m) => ESTADO_INICIAL[m.n]?.nota).filter((x) => x != null);
const promedio = notas.length ? (notas.reduce((a, b) => a + b, 0) / notas.length).toFixed(2).replace('.', ',') : '—';
const cursables = MATERIAS_PLAN.filter((m) => sinCursar(estadoDe(m.n)) && puedeCursar(m));
const rendibles = MATERIAS_PLAN.filter((m) => puedeRendir(m));
const masDestraban = MATERIAS_PLAN.filter((m) => estadoDe(m.n) !== 'aprobada').map((m) => ({ m, d: destraba(m.n).size })).sort((a, b) => b.d - a.d).slice(0, 4);

const niveles = resumenPorNivel(ESTADO_INICIAL);
const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
const proximos = proximosFinales(EXAMENES, ESTADO_INICIAL);
const plan2027 = planProximoAnio(ESTADO_INICIAL);
const NOMBRE_CUATRI = { '2027-1C': '1º cuatrimestre 2027', '2027-2C': '2º cuatrimestre 2027' };
const prox = EXAMENES.map((e) => ({ ...e, d: new Date(`${e.fecha}T00:00:00`) })).filter((e) => e.d >= hoy).sort((a, b) => a.d - b.d)[0];
const dias = prox ? Math.round((prox.d - hoy) / 86400000) : null;
const fmt = new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });

const R = 52, C = 2 * Math.PI * R;
// Mini-malla del hero: un nodo por materia del plan (columna = nivel) y una arista por correlativa real.
const GX = 40, GW = 96, GY = 22, GH = 276;
const pos = {};
for (const nv of NIVELES) {
  const ms = MATERIAS_PLAN.filter((m) => m.nivel === nv).sort((a, b) => a.n - b.n);
  ms.forEach((m, i) => { pos[m.n] = { x: GX + (nv - 1) * GW, y: ms.length === 1 ? GY + GH / 2 : GY + (GH / (ms.length - 1)) * i }; });
}
const aristas = MATERIAS_PLAN.flatMap((m) => [...m.reg, ...m.aprob].filter((p) => pos[p] && pos[m.n]).map((p) => ({ a: pos[p], b: pos[m.n] })));
const kpis = [
  { id: 'aprobadas', valor: `${aprobadas.length}`, obj: aprobadas.length, de: `/${total}`, label: 'Materias aprobadas' },
  { id: 'promedio', valor: promedio, de: '', label: `Promedio · ${notas.length} notas` },
  { id: 'finales', valor: `${rendibles.length}`, obj: rendibles.length, de: '', label: 'Finales por rendir', urgencia: r.urgencia },
];
const pasos = [
  { id: 'avance', valor: pct, etiqueta: 'Hoy', sub: 'Lo que ya aprobaste', n: aprobadas.length },
  { id: 'proy-cursando', valor: r.proyCursando.pct, etiqueta: 'Si apruebo lo que curso', sub: 'Aprobadas más las que cursás', n: r.proyCursando.n },
  { id: 'proy-finales', valor: r.proyFinales.pct, etiqueta: 'Si apruebo lo que curso y los finales', sub: 'Más los finales que podés rendir', n: r.proyFinales.n },
];
---
<Layout titulo="Inicio">
  <section class="hero" aria-labelledby="titulo-hero">
    <svg class="hero-red" viewBox="0 0 440 320" aria-hidden="true" fill="none" preserveAspectRatio="xMaxYMid meet">
      <g class="enlaces" stroke="currentColor" stroke-width="1.2">
        {aristas.map((e) => <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />)}
      </g>
      <g class="nodos">
        {MATERIAS_PLAN.map((m) => <circle data-nodo={m.n} data-estado={estadoDe(m.n)} cx={pos[m.n].x} cy={pos[m.n].y} r="6" />)}
      </g>
    </svg>
    <div class="hero-texto">
      <p class="eyebrow" data-saludo hidden></p>
      <p class="eyebrow">Ingeniería en Sistemas<span class="sep" aria-hidden="true">·</span>Plan 2023<span class="sep" aria-hidden="true">·</span>UTN FRC</p>
      <h1 id="titulo-hero">Tu carrera, <span class="resalte">materia por materia</span>.</h1>
      <p class="lead">Llevás <strong class="num" data-kpi-texto="aprobadas">{aprobadas.length}</strong> de {total} aprobadas. Mirá qué podés cursar y rendir ahora, y qué te destraba cada final.</p>
      <div class="acciones">
        <a class="btn btn-primario" href={`${base}malla/`}>Ver la malla</a>
        <a class="btn" href="#ahora">Qué puedo hacer ahora</a>
      </div>
    </div>
    <div class="anillo-card">
      <div class="anillo" role="img" aria-label={`Avance de la carrera: ${pct} por ciento`} data-anillo>
        <svg viewBox="0 0 120 120">
          <defs><linearGradient id="grad-anillo" x1="0.5" y1="0" x2="0.5" y2="1"><stop offset="0.1" class="g1" /><stop offset="0.9" class="g2" /></linearGradient></defs>
          <circle cx="60" cy="60" r={R} class="pista"/>
          <circle cx="60" cy="60" r={R} class="valor" stroke-dasharray={C.toFixed(1)} stroke-dashoffset={(C * (1 - pct / 100)).toFixed(1)} style={`--c:${C.toFixed(1)}`} transform="rotate(-90 60 60)"/>
        </svg>
        <p class="anillo-n"><span class="num" data-anillo-valor>{pct}</span><small>%</small></p>
      </div>
      <p class="anillo-t"><strong>Avance de la carrera</strong><span>{aprobadas.length} de {total} materias</span></p>
    </div>
  </section>

  <section class="proy card" aria-labelledby="h-proy" data-vista="kpis" data-proyeccion style={`--hoy:${pct}%;--cur:${r.proyCursando.pct}%;--fin:${r.proyFinales.pct}%`}>
    <header><h2 id="h-proy">Hacia dónde vas</h2><p>Tu avance de hoy y dónde llegarías</p></header>
    <ol class="pasos">
      {pasos.map((k, i) => (
        <li class="kpi paso" data-kpi={k.id} data-n={k.n} data-total={total} data-paso={i} style={`--i:${i + 1}`}>
          <p class="paso-e">{k.etiqueta}</p>
          <p class="paso-v"><span class="num" data-valor data-objetivo={k.valor}>{k.valor}</span><span class="de">%</span></p>
        </li>
      ))}
    </ol>
    <div class="apilada" aria-hidden="true"><i class="a-fin"></i><i class="a-cur"></i><i class="a-hoy"></i></div>
    <p class="leyenda-barra"><span><i class="l-hoy"></i>Aprobadas hoy</span><span><i class="l-cur"></i>Si apruebo lo que curso</span><span><i class="l-fin"></i>Más los finales</span></p>
  </section>

  <section class="kpis" aria-label="Resumen">
    {kpis.map((k, i) => (
      <div class="kpi card" data-kpi={k.id} data-nivel-urgencia={k.urgencia} style={`--i:${i + 2}`}>
        {k.id === 'finales' && <p class="sem-etq" aria-hidden="true"><span data-sem="ok">Al día</span><span data-sem="medio">A rendir</span><span data-sem="alto">Muchos pendientes</span></p>}
        <p class="kpi-v"><span class="num" data-valor data-objetivo={k.obj}>{k.valor}</span><span class="de">{k.de}</span></p>
        <p class="kpi-l">{k.label}</p>
      </div>
    ))}
  </section>

  <div class="dos">
    <section class="seccion card" aria-labelledby="h-niveles" data-vista="niveles">
      <header><h2 id="h-niveles">Avance por nivel</h2></header>
      <ul class="niveles">
        {niveles.map((n) => (
          <li data-nivel-bar={n.nv} data-total={n.total} data-aprobadas={n.aprobadas} data-mas-cursando={n.masCursando} data-mas-finales={n.masFinales}>
            <a href={`${base}malla/#nivel-${n.nv}`}>
              <span class="nv-n"><span class="num" data-ok>{n.aprobadas}</span>/{n.total}</span>
              <span class="nv-t">{NOMBRE_NIVEL[n.nv]}</span>
              <span class="nv-p num" data-pct>{Math.round((n.aprobadas / n.total) * 100)}%</span>
              <span class="barra" aria-hidden="true"><i class="b-ok" style={`width:${(n.aprobadas / n.total) * 100}%`}></i><i class="b-cursando" style={`width:${(n.masCursando / n.total) * 100}%`}></i><i class="b-finales" style={`width:${(n.masFinales / n.total) * 100}%`}></i></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="leyenda-barra"><span><i class="b-ok"></i>Aprobadas</span><span><i class="b-cursando"></i>Si apruebo lo que curso</span><span><i class="b-finales"></i>Si apruebo los finales</span></p>
    </section>

    <div class="col">
      <section class="seccion card cuenta" aria-labelledby="h-mesa" data-vista="cuenta-regresiva" id="cuenta-regresiva">
        <header><h2 id="h-mesa">Próximos finales</h2></header>
        {prox ? (
          <div data-countdown data-fecha={prox.fecha} data-materia={prox.materia}>
            <p class="cuenta-n"><span class="num" data-dias>{dias}</span><span>{dias === 1 ? 'día' : 'días'}</span></p>
            <p class="cuenta-m"><strong>{nombreCorto(prox.materia)}</strong></p>
            <p class="suave"><time datetime={prox.fecha}>{fmt.format(prox.d).replace(/^./, (c) => c.toUpperCase())}</time><span class="sep" aria-hidden="true">·</span>{prox.etiqueta}</p>
          </div>
        ) : <p class="vacio">No hay mesas cargadas. Sumalas desde el Planificador.</p>}
        <ol class="proximos" data-proximos-finales>
          {proximos.map((e) => <li data-materia={e.materia} data-fecha={e.fecha} data-tipo={e.tipo} data-opcional={e.opcional ? 'si' : null}><time datetime={e.fecha}>{fmt.format(new Date(`${e.fecha}T00:00:00`)).replace(/^./, (c) => c.toUpperCase())}</time><strong>{nombreCorto(e.materia)}</strong><small>{e.etiqueta}</small></li>)}
        </ol>
      </section>
      <section class="seccion card" aria-labelledby="h-cred" data-vista="creditos">
        <header><h2 id="h-cred">Créditos electivos</h2><a href={`${base}electivas/`}>Ver electivas</a></header>
        <div class="cred" data-creditos="ing"><p><span>Ingeniería</span><span><b class="num" data-valor>0</b>/{CREDITOS_INGENIERIA}</span></p><progress max={CREDITOS_INGENIERIA} value="0" aria-label="Créditos para Ingeniería"></progress></div>
        <div class="cred" data-creditos="analista"><p><span>Analista · 3er nivel</span><span><b class="num" data-valor>0</b>/{CREDITOS_ANALISTA}</span></p><progress max={CREDITOS_ANALISTA} value="0" aria-label="Créditos de tercer nivel para Analista"></progress></div>
      </section>
    </div>
  </div>

  <section class="seccion" id="ahora" aria-labelledby="h-ahora" data-vista="ahora">
    <header><h2 id="h-ahora">Qué puedo hacer ahora</h2><p>Según tu estado actual</p></header>
    <div class="card plan-anio" data-plan-anio>
      <h3>Tu plan para 2027</h3>
      <div class="plan-cuatris">
        {plan2027.map((c) => (
          <section data-cuatri-plan={c.id} aria-label={NOMBRE_CUATRI[c.id]}>
            <h4>{NOMBRE_CUATRI[c.id]}<small data-hs>{c.hs} hs</small></h4>
            {c.items.length ? <ul>{c.items.map((it) => <li data-materia={it.n} data-electiva={it.electiva ? 'si' : 'no'}><span class="n num">{it.electiva ? 'E' : it.n}</span><span>{it.electiva ? 'Electiva' : nombreCorto(it.n)}<small data-razon>{it.razon}</small></span></li>)}</ul> : <p class="vacio">Sin materias propuestas.</p>}
          </section>
        ))}
      </div>
      <p class="suave">Propuesta automática: da por rendido lo que cursás hoy. Ajustala en el <a href={`${base}planificador/`}>Planificador</a>.</p>
    </div>
    <div class="tres">
      <div class="card lista-c lc-cursar" data-lista="cursar">
        <h3><span class="insignia-hab">Habilitadas</span>Podés cursar</h3>
        {cursables.length ? <ul>{cursables.map((m) => <li data-materia={m.n}><span class="n num">{m.n === 99 ? 'S' : m.n}</span>{m.nombre}</li>)}</ul> : <p class="vacio">Nada habilitado por ahora.</p>}
      </div>
      <div class="card lista-c lc-finales" data-lista="finales">
        <h3>Podés rendir el final</h3>
        {rendibles.length ? <ul>{rendibles.map((m) => <li data-materia={m.n}><span class="n num">{m.n}</span>{m.nombre}</li>)}</ul> : <p class="vacio">Ningún final habilitado por ahora.</p>}
      </div>
      <div class="card lista-c lc-destraba" data-lista="destraba">
        <h3>Las que más destraban</h3>
        <ul>{masDestraban.map(({ m, d }) => <li data-materia={m.n}><span class="n num">{m.n === 99 ? 'S' : m.n}</span><span>{m.nombre}<small>destraba {d}</small></span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="seccion card respaldo" aria-labelledby="h-resp" data-vista="respaldo">
    <div>
      <h2 id="h-resp">Tus datos, tuyos</h2>
      <p class="suave">Todo se guarda solo en este navegador. Exportá un archivo para respaldarlo o seguir en otro dispositivo.</p>
    </div>
    <div class="acciones">
      <button type="button" class="btn-primario" data-accion="exportar" hidden>Exportar estado</button>
      <button type="button" data-accion="importar" hidden>Importar estado</button>
      <input type="file" accept="application/json,.json" data-importar-archivo hidden aria-label="Archivo de estado a importar" />
    </div>
    <p class="aviso" data-estado-import role="status" aria-live="polite"></p>
  </section>
</Layout>

<script>
  import '../scripts/inicio.js';
</script>


<style is:global>
  /* ---------- Hero ---------- */
  .hero { position: relative; display: grid; gap: var(--s-6); grid-template-columns: minmax(0, 1fr); align-items: center; padding: var(--s-8) var(--s-4); border-radius: calc(var(--r) + 8px); border: 1px solid var(--borde); overflow: hidden; isolation: isolate;
    background:
      radial-gradient(60% 90% at 0% 0%, color-mix(in srgb, var(--marca) 26%, transparent), transparent 70%),
      radial-gradient(55% 80% at 100% 100%, color-mix(in srgb, var(--azul-solido) 22%, transparent), transparent 70%),
      var(--sup); }
  .hero-texto { position: relative; display: grid; gap: var(--s-4); z-index: 1; }
  .hero-texto .eyebrow { text-wrap: balance; }
  .hero-texto h1 { max-width: 13ch; }
  .resalte { background: linear-gradient(100deg, var(--acento) 10%, var(--acento2) 90%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .hero-red { position: absolute; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; z-index: -1; color: var(--acento); opacity: .22; pointer-events: none; }
  @media (min-width: 761px) { .hero-red { width: 44%; opacity: .55; mask-image: linear-gradient(90deg, transparent 10%, #000 60%); -webkit-mask-image: linear-gradient(90deg, transparent 10%, #000 60%); } }
  .enlaces line { stroke-opacity: .18; stroke-dasharray: 3 7; animation: flujo 2.4s var(--suave-ease) 1 both; }
  .nodos circle { fill: var(--sup); stroke: var(--borde-fuerte); stroke-width: 1.5; transform-box: fill-box; transform-origin: center; }
  .nodos circle[data-estado='aprobada'] { fill: var(--marca); stroke: var(--marca-3); }
  .nodos circle[data-estado='promocion'] { fill: var(--e-promocion); stroke: var(--e-promocion); }
  .nodos circle[data-estado='libre'] { fill: var(--e-libre); stroke: var(--e-libre); }
  .nodos circle[data-estado='abandono'] { fill: var(--e-abandono-bg); stroke: var(--e-abandono); stroke-dasharray: 2 2; }
  .nodos circle[data-estado='recursando'] { fill: var(--e-recursando); stroke: var(--azul-fuerte); stroke-dasharray: 3 1.5; }
  .nodos circle[data-estado='regular'], .nodos circle[data-estado='cursando'] { fill: var(--azul-solido); stroke: var(--azul-fuerte); }
  .nodos circle[data-habilitada='si'][data-estado='pendiente'] { stroke: var(--acento); stroke-width: 3; animation: pulso 2.6s ease-in-out 2; }
  @keyframes flujo { to { stroke-dashoffset: -40; } }
  @keyframes pulso { 50% { transform: scale(1.5); } }

  .anillo-card { position: relative; z-index: 1; display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4); border-radius: var(--r); background: color-mix(in srgb, var(--sup) 82%, transparent); backdrop-filter: blur(8px); border: 1px solid var(--borde); box-shadow: var(--sombra-h); justify-self: start; animation: subir .7s var(--suave-ease) .15s both; }
  .anillo { position: relative; width: 112px; height: 112px; flex: none; }
  .anillo svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 4px 10px color-mix(in srgb, var(--marca) 40%, transparent)); }
  .anillo circle { fill: none; stroke-width: 10; stroke-linecap: round; }
  .g1 { stop-color: var(--marca); } .g2 { stop-color: var(--acento2); }
  .pista { stroke: var(--e-pendiente-bg); }
  .valor { stroke: url(#grad-anillo); animation: llenar 1.6s var(--suave-ease) .2s both; }
  @keyframes llenar { from { stroke-dashoffset: var(--c); } }
  .valor { transition: stroke-dashoffset 1s var(--suave-ease); }
  .anillo-n { position: absolute; inset: 0; display: flex; align-items: baseline; justify-content: center; gap: var(--s-1); padding-top: 32px; font-family: var(--f-disp); }
  .anillo-n .num { font-size: 2.25rem; font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .anillo-n small { font-size: var(--t-m); font-weight: 700; color: var(--suave); }
  .anillo-t { display: grid; gap: 2px; font-size: var(--t-s); color: var(--suave); }
  .anillo-t strong { color: var(--texto); font-family: var(--f-disp); font-size: var(--t-l); line-height: 1.15; }
  @media (min-width: 761px) {
    .hero { grid-template-columns: minmax(0, 1fr) auto; padding: var(--s-12) var(--s-12); gap: var(--s-12); }
    .anillo-card { flex-direction: column; text-align: center; padding: var(--s-6); justify-self: end; gap: var(--s-3); }
    .anillo { width: 200px; height: 200px; }
    .anillo-n { padding-top: 62px; }
    .anillo-n .num { font-size: 3.75rem; } .anillo-n small { font-size: var(--t-xl); }
  }

  /* ---------- Hacia dónde vas (hoy -> proyectado) ---------- */
  .proy { margin-top: var(--s-6); display: grid; gap: var(--s-4); }
  .proy > header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--s-1) var(--s-4); }
  .proy > header p { color: var(--suave); font-size: var(--t-s); }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: minmax(0, 1fr); }
  .paso { position: relative; display: grid; gap: var(--s-1); padding: var(--s-3) var(--s-4); border-radius: var(--r-s); background: var(--sup2); border: 1px solid var(--borde); border-left: 6px solid var(--c, var(--relleno)); }
  .paso[data-paso='0'] { --c: var(--relleno); }
  .paso[data-paso='1'] { --c: var(--azul-solido); }
  .paso[data-paso='2'] { --c: color-mix(in srgb, var(--azul-solido) 45%, var(--sup)); }
  .paso { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'e v' 'n v'; align-items: center; }
  .paso-e { grid-area: e; }
  .paso-v { grid-area: v; }
  .paso::after { grid-area: n; }
  .paso-e { font-size: var(--t-s); font-weight: 600; color: var(--suave); line-height: 1.3; }
  .paso-v { font-family: var(--f-disp); font-weight: 800; font-size: 2.5rem; line-height: 1; letter-spacing: -.03em; display: flex; align-items: baseline; }
  .paso-v .de { font-size: var(--t-xl); color: var(--suave); margin-left: var(--s-1); }
  .paso[data-paso='0'] .paso-v .num { color: var(--acento); }
  .paso[data-paso='1'] .paso-v .num, .paso[data-paso='2'] .paso-v .num { color: var(--acento2); }
  .paso::after { content: attr(data-n) ' de ' attr(data-total) ' materias'; font-size: var(--t-xs); color: var(--suave); font-variant-numeric: tabular-nums; }
  @media (min-width: 761px) {
    .pasos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-6); }
    .paso { padding: var(--s-4) var(--s-4) var(--s-4) var(--s-6); border-left-width: 1px; border-top: 6px solid var(--c); }
