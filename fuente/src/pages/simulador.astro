---
import Layout from '../layouts/Layout.astro';
import { MATERIAS, NIVELES } from '../data/plan.js';
import { CATALOGO_ELECTIVAS } from '../data/trayectos.js';
import { NOMBRE_NIVEL } from '../lib/vista.js';
import { idElectiva } from '../lib/motor.js';
import { ACCIONES, ETIQUETA_ACCION } from '../lib/simulacion.js';

const ordenar = (a, b) => (a.n === 99 ? 1 : b.n === 99 ? -1 : a.n - b.n);
const grupos = NIVELES.map((nv) => ({ id: `n${nv}`, nombre: NOMBRE_NIVEL[nv], materias: MATERIAS.filter((m) => m.nivel === nv).sort(ordenar).map((m) => ({ ...m, id: m.n })) }));
grupos.push({ id: 'electivas', nombre: 'Electivas y materias de tu licenciatura', materias: CATALOGO_ELECTIVAS.map((e) => ({ ...e, id: idElectiva(e) })) });
const FILTROS = [['debo', 'Lo que debo'], ['cursar', 'Puedo cursar'], ['todas', 'Todas']];
const detalle = (m) => m.licenciatura ? `Licenciatura · ${m.creditos} créditos al aprobar · desde ${m.desde}` : typeof m.id === 'string' ? `${m.creditos} créditos al aprobar` : m.opcional ? 'Opcional · no cuenta en las 36' : '';
const TILES = [['aprobadas', 'Aprobadas', 'de 36'], ['cursadas', 'Cursadas', 'incluye aprobadas'], ['creditos', 'Créditos Ingeniería', 'electivas'], ['analista', 'Créditos Analista', '3er nivel']];
---
<Layout titulo="Simulador" descripcion="Compará escenarios de cursado, finales y créditos sin modificar tu progreso.">
  <header class="cab cab-sim">
    <p class="eyebrow">Modo hipotético · no modifica tus datos</p>
    <h1>¿Y si…?</h1>
    <p class="lead">Elegí qué pasaría con cada materia y mirá qué se te habilita.</p>
    <details class="como-calcula">
      <summary>¿Cómo calcula?</summary>
      <div class="como-calcula-in">
        <p><strong>Regularizar y aprobar tienen efectos distintos.</strong> Para cursar y rendir, las correlativas de la columna “Cursadas” alcanzan con estar regulares; las de “Aprobadas” necesitan aprobación. Para rendir también necesitás tener regular la propia materia. Proyecto Final y Seminario tienen requisitos especiales.</p>
        <p><strong>Quedo libre</strong> simula perder la regularidad: la materia vuelve a estar para cursar y deja de habilitar lo que dependía de ella.</p>
        <p>Se comparan habilitaciones inmediatas, con todas las correlativas cumplidas. Que una materia dependa indirectamente de otra no significa que ya puedas cursarla.</p>
        <a href="https://www.institucional.frc.utn.edu.ar/sistemas/Download/Reglamentos/2023/1878.pdf" target="_blank" rel="noopener noreferrer">Ver régimen oficial · Ordenanza 1878</a>
      </div>
    </details>
  </header>

  <div class="sim" data-vista="simulador">
    <div class="lista">
      <p class="sin-js">El simulador necesita JavaScript para comparar con el progreso de tu cuenta.</p>
      <div class="herramientas-sim" data-solo-js>
        <fieldset class="filtros-sim">
          <legend class="sr-only">Qué materias mostrar</legend>
          {FILTROS.map(([v, t]) => (
            <label class="filtro-op"><input type="radio" name="sim-filtro" value={v} data-sim-filtro autocomplete="off" checked={v === 'todas'} /><span>{t} <span class="cuenta num" data-sim-cuenta={v}>0</span></span></label>
          ))}
        </fieldset>
        <label class="buscar-sim"><span class="sr-only">Buscar materia</span><input type="search" data-sim-buscar placeholder="Buscar materia" autocomplete="off" /></label>
        <div class="atajos-sim" role="group" aria-label="Escenarios rápidos">
          <button type="button" data-sim-rapido="regularizar-cursando" hidden>Regularizar lo que curso</button>
          <button type="button" data-sim-rapido="aprobar-debo" hidden>Aprobar todo lo que debo</button>
          <button type="button" class="volver-real" data-accion="reset-simulacion" hidden>Volver a mi estado real</button>
        </div>
      </div>
      {grupos.map((g) => (
        <section class="grupo" data-sim-grupo={g.id} aria-labelledby={`sim-${g.id}`}>
          <h2 id={`sim-${g.id}`}>{g.nombre}</h2>
          {g.id === 'electivas' && <p class="suave nota-grupo" data-sim-licenciatura></p>}
          {g.materias.map((m) => (
            <div class="fila" data-sim-materia={m.id} data-sim-licenciatura-id={m.licenciatura || ''} data-estado-real="pendiente" data-sim-cambiada="no" hidden={Boolean(m.licenciatura)}>
              <div class="fila-info">
                <span class="n num">{typeof m.id === 'number' ? m.n === 99 ? 'S' : m.n : 'E'}</span>
                <span class="fila-nombre">{m.nombre}{detalle(m) && <small>{detalle(m)}</small>}</span>
                <span class="fila-estados"><span class="chip" data-estado="pendiente" data-sim-chip="real">Pendiente</span><span class="sr-only" data-sim-chip-sr hidden>, en el escenario: </span><span class="flecha" aria-hidden="true" hidden>→</span><span class="chip" data-estado="pendiente" data-sim-chip="proy" hidden></span></span>
              </div>
              {m.correlativasConfirmadas === false && <p class="aviso-trayecto">Correlativas propias y oferta a confirmar: sirve para estimar créditos, no para afirmar que la inscripción está habilitada.</p>}
              <fieldset class="seg" data-solo-js data-sim-opciones>
                <legend class="sr-only">Qué pasa con {m.nombre}</legend>
                {ACCIONES.map((a) => (
                  <label class="seg-op" data-sim-op={a}><input type="radio" name={`sim-${m.id}`} value={a} checked={a === 'real'} /><span>{ETIQUETA_ACCION[a]}</span></label>
                ))}
              </fieldset>
            </div>
          ))}
        </section>
      ))}
      <div class="vacio" data-sim-sin-resultados hidden>
        <p data-sim-sin-texto>No hay materias que coincidan.</p>
        <button type="button" data-sim-ver-todas hidden>Ver todas</button>
      </div>
    </div>

    <aside class="resultado card" id="resultado-sim" tabindex="-1" aria-labelledby="h-res" data-sim-resultado data-cambios="no">
      <div class="res-cab">
        <h2 id="h-res">Tu escenario</h2>
        <button type="button" class="btn-chico" data-sim-deshacer hidden>Deshacer todo</button>
      </div>
      <p class="res-resumen" data-sim-resumen role="status" aria-live="polite">Elegí qué pasaría con alguna materia para comparar. Tu progreso real no cambia.</p>
      <dl class="tiles">
        {TILES.map(([id, t, sub]) => (
          <div class="tile" data-sim-tile={id} data-signo="0">
            <dt>{t} <small>{sub}</small></dt>
            <dd>
              <span class="tile-antes"><span class="sr-only">Hoy </span><span data-sim-real={id}>0</span><span class="flecha" aria-hidden="true">→</span><span class="sr-only">; en el escenario </span></span>
              <strong class="num" data-sim-proy={id}>0</strong>
              <span class="delta num" data-sim-delta={id}></span>
            </dd>
          </div>
        ))}
      </dl>
      <div class="res-listas" hidden>
        <section><h3>Nuevas para cursar <span class="cuenta num" data-sim-n="cursar"></span></h3><ul data-sim-lista="cursar"></ul></section>
        <section><h3>Nuevos finales <span class="cuenta num" data-sim-n="finales"></span></h3><ul data-sim-lista="finales"></ul></section>
        <section class="perdidas" data-sim-perdidas hidden><h3>Se perderían <span class="cuenta num" data-sim-n="perdidas"></span></h3><ul data-sim-lista="perdidas"></ul></section>
      </div>
    </aside>
  </div>

  <div class="barra-sim" data-sim-barra hidden>
    <p class="barra-texto" data-sim-barra-texto></p>
    <button type="button" class="barra-deshacer" data-sim-deshacer-barra aria-label="Deshacer todo"></button>
    <a class="btn btn-primario" href="#resultado-sim" data-sim-ver>Ver resultado</a>
  </div>
</Layout>

<script>import '../scripts/simulador.js';</script>

<style is:global>
  /* Cabecera corta: las reglas largas quedan en un desplegable */
  .cab-sim { margin-bottom: var(--s-6); gap: var(--s-2); }
  .cab-sim .lead { font-size: var(--t-m); }
  .como-calcula { max-width: 44rem; font-size: var(--t-s); }
  .como-calcula summary { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; cursor: pointer; font-weight: 700; color: var(--link); list-style: none; border-radius: var(--r-s); }
  .como-calcula summary::-webkit-details-marker { display: none; }
  .como-calcula summary::before { content: ''; width: 18px; height: 18px; flex: none; background: currentColor; mask: var(--i-info) center / contain no-repeat; -webkit-mask: var(--i-info) center / contain no-repeat; }
  .como-calcula summary::after { content: ''; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); transition: transform .2s; }
  .como-calcula[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .como-calcula-in { display: grid; gap: var(--s-2); padding: var(--s-3) var(--s-4); margin-top: var(--s-1); border-radius: var(--r-s); background: var(--sup); border: 1px solid var(--borde); }

  .sim { display: grid; gap: var(--s-6); }
  @media (min-width: 1050px) {
    .sim { grid-template-columns: minmax(0, 1fr) 24rem; align-items: start; }
    .resultado { position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow: auto; }
  }

  /* Herramientas: filtros segmentados, buscador y escenarios rápidos */
  .herramientas-sim { display: grid; gap: var(--s-3); margin-bottom: var(--s-4); }
  .filtros-sim { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; margin: 0; padding: 3px; border: 1px solid var(--borde-fuerte); border-radius: 999px; background: var(--sup); min-width: 0; }
  .filtro-op { position: relative; display: flex; min-width: 0; }
  .filtro-op input, .seg-op input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .filtro-op > span { flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px; min-height: 40px; padding: 2px var(--s-1); border-radius: 999px; font-size: var(--t-xs); white-space: nowrap; font-weight: 600; line-height: 1.15; text-align: center; color: var(--suave); transition: background .15s, color .15s; }
  .filtro-op:hover > span { color: var(--texto); }
  .filtro-op input:checked + span { background: var(--acento); color: var(--sobre-acento); }
  .filtro-op:has(input:focus-visible) > span, .seg-op:has(input:focus-visible) > span { outline: 3px solid var(--acento); outline-offset: 2px; }
  .filtro-op .cuenta { font-size: var(--t-xs); min-width: 1.6em; padding: 0 5px; border-radius: 999px; background: var(--sup2); color: var(--texto); }
  .filtro-op input:checked + span .cuenta { background: color-mix(in srgb, var(--sobre-acento) 22%, transparent); color: inherit; }
  .buscar-sim input { width: 100%; min-width: 0; min-height: 44px; font: inherit; font-size: var(--t-s); color: var(--texto); background: var(--sup); border: 1px solid var(--borde-fuerte); border-radius: 999px; padding: var(--s-2) var(--s-4); }
  .atajos-sim { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .atajos-sim:not(:has(button:not([hidden]))) { display: none; }
  .atajos-sim button { font-size: var(--t-xs); padding: var(--s-1) var(--s-3); background: var(--sup2); border-color: var(--borde); }
  .atajos-sim .volver-real { color: var(--acento2); border-color: var(--acento2); background: var(--sup); }
  @media (min-width: 640px) { .herramientas-sim { grid-template-columns: auto minmax(0, 1fr); } .atajos-sim { grid-column: 1 / -1; } .filtro-op > span { font-size: var(--t-s); padding-inline: var(--s-3); gap: 6px; } }

  /* Grupos y filas compactas */
  .grupo { margin-bottom: var(--s-6); }
  .grupo h2 { font-size: var(--t-m); text-transform: uppercase; letter-spacing: .06em; color: var(--suave); padding-bottom: var(--s-2); margin-bottom: var(--s-2); border-bottom: 1px solid var(--borde); }
  .nota-grupo { font-size: var(--t-xs); margin-bottom: var(--s-2); }
  .fila { border: 1px solid var(--borde); border-radius: var(--r-s); background: var(--sup); padding: var(--s-2) var(--s-3) var(--s-3); margin: 0 0 var(--s-2); display: grid; gap: var(--s-2); min-width: 0; transition: border-color .15s, background .15s, box-shadow .15s; }
  .fila:hover, .fila:focus-within { border-color: var(--borde-fuerte); }
  .fila[data-sim-cambiada='si'] { border-color: var(--acento2); background: var(--acento2-suave); box-shadow: inset 4px 0 0 var(--acento2); }
  .fila-info { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-1) var(--s-3); min-width: 0; }
  .fila-info .n { width: 28px; height: 28px; border-radius: 8px; font-size: var(--t-xs); }
  .fila-nombre { font-weight: 600; font-size: var(--t-s); flex: 1 1 9rem; min-width: 0; line-height: 1.3; }
  .fila-nombre small { display: block; color: var(--suave); font-weight: 400; font-size: var(--t-xs); }
  .fila-estados { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--s-1); margin-left: auto; }
  .fila-estados .flecha { color: var(--acento2); font-weight: 800; }
  .fila[data-sim-cambiada='si'] [data-sim-chip='real'] { opacity: .7; }
  .aviso-trayecto { font-size: var(--t-xs); color: var(--suave); }

  /* Control segmentado: radios reales (teclado con flechas), con la etiqueta como botón */
  .seg { display: flex; gap: 2px; margin: 0; padding: 3px; border: 1px solid var(--borde); border-radius: var(--r-s); background: var(--sup2); min-width: 0; }
  .seg-op { position: relative; flex: 1 1 0; display: flex; min-width: 0; }
  .seg-op > span { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 40px; padding: 2px 3px; letter-spacing: -.01em; border-radius: 9px; font-size: var(--t-xs); font-weight: 600; line-height: 1.15; text-align: center; color: var(--suave); transition: background .15s, color .15s, box-shadow .15s; }
  .seg-op:hover > span { color: var(--texto); background: var(--sup); }
  .seg-op input:checked + span { background: var(--sup); color: var(--texto); box-shadow: 0 0 0 1px var(--borde-fuerte), var(--sombra); }
  .seg-op[data-sim-op='regular'] input:checked + span { background: var(--e-regular-bg); color: var(--e-regular); box-shadow: 0 0 0 1px currentColor; }
  .seg-op[data-sim-op='aprobada'] input:checked + span { background: var(--e-aprobada-bg); color: var(--e-aprobada); box-shadow: 0 0 0 1px currentColor; }
  .seg-op[data-sim-op='libre'] input:checked + span { background: var(--e-libre-bg); color: var(--e-libre); box-shadow: 0 0 0 1px currentColor; }
  @media (min-width: 640px) { .seg { display: inline-flex; justify-self: start; } .seg-op { flex: 0 0 auto; } .seg-op > span { padding-inline: var(--s-3); } }

  .lista > .vacio { display: grid; justify-items: center; gap: var(--s-2); }

  /* Resultado */
  .resultado { border-top: 4px solid var(--acento2); align-self: start; }
  .resultado:focus-visible { outline-offset: 4px; }
  .res-cab { display: flex; justify-content: space-between; gap: var(--s-3); align-items: center; margin-bottom: var(--s-2); }
  .res-cab h2 { font-size: var(--t-l); }
  .btn-chico { min-height: 44px; font-size: var(--t-xs); padding: var(--s-1) var(--s-3); }
  .res-resumen { font-size: var(--t-s); color: var(--suave); }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-2); margin: var(--s-4) 0 0; }
  .tile { display: grid; align-content: space-between; gap: var(--s-1); padding: var(--s-3); border-radius: var(--r-s); background: var(--sup2); border: 1px solid var(--borde); min-width: 0; }
  .tile dt { font-size: var(--t-xs); font-weight: 700; line-height: 1.25; }
  .tile dt small { display: block; font-weight: 400; color: var(--suave); }
  .tile dd { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px var(--s-2); }
  .tile strong { font-size: var(--t-xl); line-height: 1.1; }
  .tile-antes { color: var(--suave); font-size: var(--t-s); font-family: var(--f-disp); font-variant-numeric: tabular-nums; }
  .tile-antes .flecha { margin-left: 4px; }
  .delta { font-size: var(--t-xs); font-weight: 800; padding: 1px 7px; border-radius: 999px; }
  .delta:empty { display: none; }
  .tile[data-signo='1'] { border-color: color-mix(in srgb, var(--acento) 45%, var(--borde)); }
  .tile[data-signo='1'] .delta { background: var(--acento-suave); color: var(--acento); }
  .tile[data-signo='-1'] .delta { background: var(--e-libre-bg); color: var(--e-libre); }
  .tile[data-signo='0'] .delta { color: var(--suave); padding-inline: 0; font-weight: 600; }
  .resultado[data-cambios='no'] .tile-antes, .resultado[data-cambios='no'] .delta { display: none; }
  .res-listas { display: grid; gap: var(--s-4); margin-top: var(--s-4); }
  .res-listas h3 { display: flex; align-items: center; gap: var(--s-2); font-size: var(--t-m); margin-bottom: var(--s-2); }
  .res-listas h3 .cuenta { font-size: var(--t-xs); padding: 0 7px; border-radius: 999px; background: var(--acento-suave); color: var(--acento); }
  .res-listas .perdidas h3 .cuenta { background: var(--e-libre-bg); color: var(--e-libre); }
  .res-listas ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); font-size: var(--t-s); }
  .res-listas li:not(.vacio) { display: flex; align-items: start; gap: var(--s-3); line-height: 1.3; font-weight: 600; padding: var(--s-2) var(--s-3); border-radius: var(--r-s); background: var(--sup); border: 1px solid var(--borde); }
  .res-listas .perdidas li:not(.vacio) { border-left: 4px solid var(--e-libre); }
  .res-listas li .n { width: 28px; height: 28px; border-radius: 8px; font-size: var(--t-xs); }
  .res-listas small { display: block; margin-top: 2px; color: var(--suave); font-weight: 400; font-size: var(--t-xs); }
  .res-listas .vacio { text-align: left; padding: var(--s-2) var(--s-3); }

  /* Barra fija del celular: resumen + atajo al resultado (encima de la nav inferior) */
  .barra-sim { position: fixed; left: 0; right: 0; bottom: env(safe-area-inset-bottom); z-index: 25; display: flex; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-4); background: color-mix(in srgb, var(--sup) 96%, transparent); backdrop-filter: blur(10px); border-top: 2px solid var(--acento2); box-shadow: 0 -6px 18px rgb(0 0 0 / .12); }
  .barra-texto { flex: 1; min-width: 0; font-size: var(--t-s); font-weight: 700; line-height: 1.25; font-variant-numeric: tabular-nums; }
  .barra-texto small { display: block; font-weight: 500; color: var(--suave); font-size: var(--t-xs); }
  .barra-deshacer { flex: none; width: 44px; padding: 0; }
  .barra-deshacer::before { content: ''; width: 18px; height: 18px; background: currentColor; transform: scaleX(-1); mask: var(--i-recursar) center / contain no-repeat; -webkit-mask: var(--i-recursar) center / contain no-repeat; }
  .barra-sim .btn-primario { flex: none; white-space: nowrap; }
  @media (max-width: 900px) { .barra-sim { bottom: calc(var(--nav-h) + env(safe-area-inset-bottom)); } }
  @media (min-width: 1050px) { .barra-sim { display: none !important; } }
  @media (max-width: 1049px) { [data-vista='simulador'] { padding-bottom: 72px; } }
</style>
